generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum VehicleType {
  CAR
  BIKE
  BIKE_GEARED
  BIKE_NON_GEARED
}

enum TrainerType {
  INDEPENDENT
  DRIVING_SCHOOL
}

enum TrainerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Trainer {
  id             Int           @id @default(autoincrement())

  // ── Basic info (existing) ─────────────────────────────────────────────────
  name           String
  mobile         String        @unique
  city           String
  experience     Int
  licenseNumber  String
  trainerType    TrainerType
  status         TrainerStatus @default(PENDING)
  rating         Float?        @default(0)
  basePrice      Int?
  verifiedSchool Boolean       @default(false)
  createdAt      DateTime      @default(now())

  // ── New: contact & profile ────────────────────────────────────────────────
  email          String?       @unique    // for login & notifications
  bio            String?                  // shown on public profile
  photoUrl       String?                  // profile photo

  // ── New: location & pincode matching ─────────────────────────────────────
  pincode        String?                  // trainer's home/base pincode
  serviceArea    String[]                 // all pincodes this trainer covers

  // ── New: expertise ────────────────────────────────────────────────────────
  languages      String[]                 // e.g. ["Hindi", "English"]
  vehicleTypes   VehicleType[]            // all vehicle types they can train

  // ── New: credentials ─────────────────────────────────────────────────────
  aadharNo       String?                  // ⚠️ hash before storing in prod

  // ── Existing relations ────────────────────────────────────────────────────
  vehicles       Vehicle[]
  bookings       Booking[]

  @@index([city])
  @@index([status])
  @@index([pincode])          // new: for pincode-based lookups
}

model Vehicle {
  id            Int         @id @default(autoincrement())
  trainerId     Int
  type          VehicleType
  vehicleNumber String
  dualControl   Boolean
  insured       Boolean
  createdAt     DateTime    @default(now())

  trainer       Trainer     @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
}

model Booking {
  id            Int           @id @default(autoincrement())
  trainerId     Int
  packageName   String
  amount        Int
  platformFee   Int?
  trainerPayout Int?

  customerName  String
  mobile        String
  city          String
  address       String

  // ── New: pincode on booking ───────────────────────────────────────────────
  pincode       String?                   // learner's pincode at time of booking

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  bookingDate   DateTime?
  createdAt     DateTime      @default(now())

  trainer       Trainer       @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([pincode])          // new: for area-based analytics
}
// ─── Admin Session (Production Auth Upgrade) ───────────────────────────────

model AdminSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
}