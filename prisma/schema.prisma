generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trainer {
  id              Int               @id @default(autoincrement())
  name            String
  mobile          String            @unique
  city            String
  experience      Int
  licenseNumber   String
  trainerType     TrainerType       @default(INDEPENDENT)
  status          TrainerStatus     @default(PENDING)
  rating          Float?            @default(0)
  basePrice       Int?
  verifiedSchool  Boolean           @default(false)
  createdAt       DateTime          @default(now())
  email           String?           @unique
  bio             String?
  photoUrl        String?
  pincode         String?
  serviceArea     String[]
  languages       String[]
  vehicleTypes    VehicleType[]
  aadharEncrypted String?
  aadharIV        String?
  aadharAuthTag   String?
  adminNotes      String?
  packagesJson    String?
  bookings        Booking[]
  reviews         Review[]
  documents       TrainerDocument[]
  vehicles        Vehicle[]

  @@index([city])
  @@index([status])
  @@index([pincode])
}

model Vehicle {
  id                  Int         @id @default(autoincrement())
  trainerId           Int
  type                VehicleType
  vehicleNumber       String
  dualControl         Boolean     @default(false)
  insured             Boolean     @default(false)
  createdAt           DateTime    @default(now())
  rcNumber            String?
  vehicleYear         Int?
  insuranceValidUntil DateTime?
  trainer             Trainer     @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
}

model TrainerDocument {
  id        Int      @id @default(autoincrement())
  trainerId Int
  docType   String
  fileName  String
  createdAt DateTime @default(now())
  fileUrl   String
  trainer   Trainer  @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
  @@index([docType])
}

model Booking {
  id                Int           @id @default(autoincrement())
  trainerId         Int
  packageName       String
  amount            Int
  platformFee       Int?
  trainerPayout     Int?
  customerName      String
  mobile            String
  city              String
  address           String
  pincode           String?
  status            BookingStatus @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  bookingDate       DateTime?
  createdAt         DateTime      @default(now())
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  trainer           Trainer       @relation(fields: [trainerId], references: [id])
  review            Review?

  @@index([trainerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([pincode])
}

model AdminSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
}

model Waitlist {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model StudentWaitlist {
  id        String   @id @default(cuid())
  name      String?
  phone     String   @unique
  email     String?
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_waitlist")
}

model OutreachLead {
  id              Int       @id @default(autoincrement())
  name            String
  phone           String    @unique
  city            String
  source          String    @default("manual")
  outreachStatus  String    @default("PENDING")
  whatsappSent    Boolean   @default(false)
  smsSent         Boolean   @default(false)
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([outreachStatus])
  @@index([city])
}

model Review {
  id           Int      @id @default(autoincrement())
  bookingId    Int      @unique
  trainerId    Int
  rating       Int
  comment      String?
  customerName String?
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id])
  trainer      Trainer  @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
}

model DLReminder {
  id           Int      @id @default(autoincrement())
  mobile       String
  dlExpiryDate DateTime
  name         String?
  reminded60   Boolean  @default(false)
  reminded30   Boolean  @default(false)
  reminded7    Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([dlExpiryDate])
  @@index([active])
}

model DriverRequest {
  id               Int                 @id @default(autoincrement())
  customerName     String
  mobile           String
  email            String?
  city             String
  tripType         String
  startDate        DateTime
  endDate          DateTime?
  days             Int                 @default(1)
  pickupAddress    String
  notes            String?
  estimatedPrice   Float               @default(0)
  platformFee      Float?
  driverPayout     Float?
  finalPrice       Float?
  status           DriverRequestStatus @default(PENDING)
  assignedDriverId Int?
  adminNotes       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assignedDriver   DriverApplication?  @relation(fields: [assignedDriverId], references: [id])

  @@index([status])
  @@index([city])
  @@index([startDate])
  @@index([assignedDriverId])
}

model DriverApplication {
  id           Int                     @id @default(autoincrement())
  name         String
  mobile       String                  @unique
  email        String?
  city         String
  pincode      String
  licenseNo    String
  licenseType  String
  yearsExp     Int
  tripTypes    String
  languages    String
  availability String
  hasOwnCar    Boolean                 @default(false)
  carModel     String?
  about        String?
  photoUrl     String?
  status       DriverApplicationStatus @default(PENDING)
  adminNotes   String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  requests     DriverRequest[]

  @@index([status])
  @@index([city])
}

enum VehicleType {
  CAR
  BIKE
  BIKE_GEARED
  BIKE_NON_GEARED
}

enum TrainerType {
  INDEPENDENT
  DRIVING_SCHOOL
}

enum TrainerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  PENDING_COORDINATION
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum DriverRequestStatus {
  PENDING
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum DriverApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}
