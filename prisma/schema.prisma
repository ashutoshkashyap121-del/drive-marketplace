generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ───────────────────────────────── ENUMS ─────────────────────────────────
//

enum VehicleType {
  CAR
  BIKE
  BIKE_GEARED
  BIKE_NON_GEARED
}

enum TrainerType {
  INDEPENDENT
  DRIVING_SCHOOL
}

enum TrainerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

//
// ───────────────────────────────── MODELS ─────────────────────────────────
//

model Trainer {
  id             Int           @id @default(autoincrement())

  // ── Basic info ─────────────────────────────────────────────
  name           String
  mobile         String        @unique
  city           String
  experience     Int
  licenseNumber  String
  trainerType    TrainerType   @default(INDEPENDENT)
  status         TrainerStatus @default(PENDING)
  rating         Float?        @default(0)
  basePrice      Int?
  verifiedSchool Boolean       @default(false)
  createdAt      DateTime      @default(now())

  // ── Contact & profile ─────────────────────────────────────
  email          String?       @unique
  bio            String?
  photoUrl       String?

  // ── Location ──────────────────────────────────────────────
  pincode        String?
  serviceArea    String[]

  // ── Expertise ─────────────────────────────────────────────
  languages      String[]
  vehicleTypes   VehicleType[]

  // ── Credentials (ENCRYPTED Aadhaar) ───────────────────────
aadharEncrypted String?
aadharIV        String?
aadharAuthTag   String?

  // ── Relations ─────────────────────────────────────────────
  vehicles       Vehicle[]
  bookings       Booking[]
  documents      TrainerDocument[]

  @@index([city])
  @@index([status])
  @@index([pincode])
}

//
// ───────────────────────────── VEHICLES ─────────────────────────────
//

model Vehicle {
  id                  Int         @id @default(autoincrement())
  trainerId           Int
  type                VehicleType
  vehicleNumber       String
  dualControl         Boolean     @default(false)
  insured             Boolean     @default(false)
  createdAt           DateTime    @default(now())

  // Extra vehicle details
  rcNumber            String?
  vehicleYear         Int?
  insuranceValidUntil DateTime?

  trainer             Trainer     @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
}

//
// ───────────────────────── TRAINER DOCUMENTS ─────────────────────────
//

model TrainerDocument {
  id          Int      @id @default(autoincrement())
  trainerId   Int
  docType     String   // "LICENSE", "INSURANCE", "RC"
  fileName    String
  base64Data  String   @db.Text
  createdAt   DateTime @default(now())

  trainer     Trainer  @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
  @@index([docType])
}

//
// ───────────────────────── BOOKINGS ─────────────────────────
//

model Booking {
  id            Int           @id @default(autoincrement())
  trainerId     Int
  packageName   String
  amount        Int
  platformFee   Int?
  trainerPayout Int?

  customerName  String
  mobile        String
  city          String
  address       String
  pincode       String?

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  bookingDate   DateTime?
  createdAt     DateTime      @default(now())

  trainer       Trainer       @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([pincode])
}

//
// ───────────────────────── ADMIN MODELS ─────────────────────────
//

model AdminSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
}