generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum VehicleType {
  CAR
  BIKE
  BIKE_GEARED
  BIKE_NON_GEARED
}

enum TrainerType {
  INDEPENDENT
  DRIVING_SCHOOL
}

enum TrainerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Trainer {
  id             Int           @id @default(autoincrement())

  // Basic info
  name           String
  mobile         String        @unique
  city           String
  experience     Int
  licenseNumber  String
  trainerType    TrainerType   @default(INDEPENDENT)
  status         TrainerStatus @default(PENDING)
  rating         Float?        @default(0)
  basePrice      Int?
  verifiedSchool Boolean       @default(false)
  createdAt      DateTime      @default(now())

  // Contact & profile
  email          String?       @unique
  bio            String?
  photoUrl       String?

  // Location
  pincode        String?
  serviceArea    String[]

  // Expertise
  languages      String[]
  vehicleTypes   VehicleType[]

  // Aadhaar (encrypted — AES-256-GCM)
  aadharEncrypted String?
  aadharIV        String?
  aadharAuthTag   String?

  // Relations
  vehicles       Vehicle[]
  bookings       Booking[]
  documents      TrainerDocument[]

  @@index([city])
  @@index([status])
  @@index([pincode])
}

model Vehicle {
  id                  Int         @id @default(autoincrement())
  trainerId           Int
  type                VehicleType
  vehicleNumber       String
  dualControl         Boolean     @default(false)
  insured             Boolean     @default(false)
  createdAt           DateTime    @default(now())

  // Extended fields
  rcNumber            String?
  vehicleYear         Int?
  insuranceValidUntil DateTime?

  trainer             Trainer     @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
}

model TrainerDocument {
  id          Int      @id @default(autoincrement())
  trainerId   Int
  docType     String   // "LICENSE" | "INSURANCE" | "RC"
  fileName    String
  fileUrl     String   // Cloudinary secure_url
  createdAt   DateTime @default(now())

  trainer     Trainer  @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
  @@index([docType])
}

model Booking {
  id            Int           @id @default(autoincrement())
  trainerId     Int
  packageName   String
  amount        Int
  platformFee   Int?
  trainerPayout Int?

  customerName  String
  mobile        String
  city          String
  address       String
  pincode       String?

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // ── Razorpay ──────────────────────────────────────────────────────────────
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique

  bookingDate   DateTime?
  createdAt     DateTime      @default(now())

  trainer       Trainer       @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([pincode])
}

model AdminSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
}
// Add this model to the bottom of your prisma/schema.prisma file

model Waitlist {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}
model StudentWaitlist {
  id        String   @id @default(cuid())
  name      String?
  phone     String   @unique
  email     String?
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_waitlist")
}