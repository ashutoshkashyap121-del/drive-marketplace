generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  CAR
  BIKE
}

enum TrainerType {
  INDEPENDENT
  DRIVING_SCHOOL
}

enum TrainerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Trainer {
  id             Int           @id @default(autoincrement())
  name           String
  mobile         String        @unique
  city           String
  experience     Int
  licenseNumber  String
  trainerType    TrainerType
  status         TrainerStatus @default(PENDING)
  rating         Float?        @default(0)
  basePrice      Int?
  verifiedSchool Boolean       @default(false) // ✅ CAR training safety gate
  createdAt      DateTime      @default(now())

  vehicles       Vehicle[]
  bookings       Booking[]

  @@index([city])
  @@index([status])
}

model Vehicle {
  id            Int         @id @default(autoincrement())
  trainerId     Int
  type          VehicleType
  vehicleNumber String
  dualControl   Boolean
  insured       Boolean
  createdAt     DateTime    @default(now())

  trainer       Trainer     @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
}

model Booking {
  id            Int           @id @default(autoincrement())
  trainerId     Int
  packageName   String
  amount        Int

  platformFee   Int?          // ✅ revenue tracking
  trainerPayout Int?          // ✅ margin calculation

  customerName  String
  mobile        String
  city          String
  address       String

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  bookingDate   DateTime?
  createdAt     DateTime      @default(now())

  trainer       Trainer       @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
  @@index([status])
  @@index([paymentStatus])
}
